# Copy to .env and fill in real values. Do not commit .env.
#   cp .env.example .env
#
# Docker Compose interpolates this file and will not start MySQL/backend
# without JWT_SECRET, DB_PASSWORD, and MYSQL_ROOT_PASSWORD.
#
# Local H2 (mvn spring-boot:run) only needs mail/Paystack if you use those features.

# --- Required for docker compose ---
JWT_SECRET=
MYSQL_ROOT_PASSWORD=
DB_USERNAME=school
DB_PASSWORD=
RABBITMQ_USER=school
RABBITMQ_PASSWORD=
RABBITMQ_ERLANG_COOKIE=

# --- Site ---
REQUIRE_HTTPS=false
SEED_ENABLED=false
FRONTEND_ORIGIN=http://localhost:3000
# VPS HTTPS (Caddy on 80/443):
# SITE_HOST=68.169.55.92
# FRONTEND_ORIGIN=https://68.169.55.92.sslip.io
# REQUIRE_HTTPS=true
# ACME_EMAIL=admin@tendersprouts.com.ng

# --- SMTP ---
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL=false

# --- Paystack ---
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Live keys for Render later (do not put sk_live on the current VPS):
# PAYSTACK_LIVE_SECRET_KEY=
# PAYSTACK_LIVE_PUBLIC_KEY=
# Webhook URL: https://your-host/api/fees/payments/webhook

# --- Optional: local MySQL instead of H2 ---
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:mysql://localhost:3306/school_portal?characterEncoding=UTF-8&useUnicode=true&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false

# --- WhatsApp Cloud API ---
# WHATSAPP_ENABLED=false
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_LANGUAGE_CODE=en
# WHATSAPP_TPL_WELCOME=portal_welcome
# WHATSAPP_TPL_PASSWORD_RESET=portal_password_reset
# WHATSAPP_TPL_FEES=fees_published
# WHATSAPP_TPL_RESULTS=results_published
# WHATSAPP_TPL_EXAM=exam_timetable_published
