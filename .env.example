# Copy to .env and fill in values, then start the backend with these env vars set.
# PowerShell example:
#   Get-Content .env | ForEach-Object { if ($_ -match '^(?!#)(.+?)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }
#   mvn spring-boot:run
#
# Local default uses H2 file DB under ./data (no MySQL needed).
# Production (Railway + MySQL): see DEPLOY.md — set variables in the Railway UI, not in a committed .env.

# --- Docker Compose (backend + MySQL) ---
#   cp .env.example .env
#   docker compose up --build
# API: http://localhost:8080   health: http://localhost:8080/actuator/health
#
# JWT is required by the prod profile the container uses.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
MYSQL_ROOT_PASSWORD=schoolroot
DB_USERNAME=school
DB_PASSWORD=schoolpass
REQUIRE_HTTPS=false
SEED_ENABLED=true

# --- Local / shared ---
MAIL_ENABLED=true
MAIL_FROM=noreply@yourdomain.com
FRONTEND_ORIGIN=http://localhost:3000

# --- Paystack (parent school fee payments) ---
# PAYSTACK_ENABLED=true
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# Webhook URL (Paystack dashboard): https://your-api-host/api/fees/payments/webhook

# --- Optional: run local against MySQL instead of H2 ---
# SPRING_PROFILES_ACTIVE=prod
# FRONTEND_ORIGIN=http://localhost:3000
# JWT_SECRET=local-dev-secret-at-least-32-characters-long
# REQUIRE_HTTPS=false
# DB_URL=jdbc:mysql://localhost:3306/school_portal?characterEncoding=UTF-8&useUnicode=true&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
# DB_USERNAME=root
# DB_PASSWORD=your-password
# SEED_ENABLED=true

# --- SMTP (pick one provider below) ---

# Mailtrap (recommended for local dev): https://mailtrap.io
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=your-mailtrap-username
# MAIL_PASSWORD=your-mailtrap-password

# Gmail (use an App Password, not your normal password)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password

# Outlook / Microsoft 365
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=you@school.edu
# MAIL_PASSWORD=your-password

# SendGrid
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key

# --- Railway production checklist (set in Railway dashboard) ---
# SPRING_PROFILES_ACTIVE=prod
# FRONTEND_ORIGIN=https://your-frontend.vercel.app
# JWT_SECRET=...
# SEED_ENABLED=false
# REQUIRE_HTTPS=true
# Add Railway MySQL and link it (MYSQLHOST / MYSQLUSER / MYSQLPASSWORD / …)
# Or set DB_URL, DB_USERNAME, DB_PASSWORD explicitly
